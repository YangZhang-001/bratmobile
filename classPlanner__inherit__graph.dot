digraph "Planner"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="Planner",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Searches the transition system and extracts a plan."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="HorizonStarPlanner",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHorizonStarPlanner.html",tooltip="Performs iterative deepening search over one unit of modular expansion (see below),..."];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="NoPlanner",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classNoPlanner.html",tooltip="Does not extract a plan."];
}
