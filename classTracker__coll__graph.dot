digraph "Tracker"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="Tracker",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Tracking interface: Bridge between the real world and the simulation. Is used for tracking execution ..."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" threshold" ,fontname="Helvetica"];
  Node2 [label="Threshold",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classThreshold.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" learner" ,fontname="Helvetica"];
  Node3 [label="ThresholdLearner",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classThresholdLearner.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" Di_weights\nDn_weights" ,fontname="Helvetica"];
  Node4 [label="Bundle",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBundle.html",tooltip=" "];
}
