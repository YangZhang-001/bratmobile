digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="Configurator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classConfigurator.html",tooltip=" "];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="FocusedConfigurator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFocusedConfigurator.html",tooltip="Configurator that only replans if the current task fails."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="AttentiveConfigurator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classAttentiveConfigurator.html",tooltip="Configurator with long-range planning. It explores transitions out of a state until a DEFAULT Task is..."];
  Node2 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="B2BConfigurator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classB2BConfigurator.html",tooltip="B2BConfigurator is a class that extends the AttentiveConfigurator to eliminate the Task splitting in ..."];
  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="DiscreteConfigurator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classDiscreteConfigurator.html",tooltip="Configurator that discretises DEFAULT tasks into fixed-length segments. Basically,..."];
  Node0 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="ReactiveConfigurator",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classReactiveConfigurator.html",tooltip="Implements a Braitenberg vehicle: only simulates one Task at a time."];
}
