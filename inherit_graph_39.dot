digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="Tracker",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTracker.html",tooltip="Tracking interface: Bridge between the real world and the simulation. Is used for tracking execution ..."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="ClosedLoop_Tracker",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classClosedLoop__Tracker.html",tooltip="Tracks task execution by observing changes in tracked disturbance."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="DeadReckoner",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classDeadReckoner.html",tooltip="Tracks task execution through dead reckoning."];
}
