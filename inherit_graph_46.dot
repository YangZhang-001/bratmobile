digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="WorldBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classWorldBuilder.html",tooltip=" "];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="LaserFocus",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classLaserFocus.html",tooltip="Gets all points in the way of the task and makes a body which is a bounding upright box around all po..."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="WorldPointBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classWorldPointBuilder.html",tooltip="Each point is an object but each time the world is built, only the points in the way of the task are ..."];
  Node2 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="EveryOtherFeatureBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEveryOtherFeatureBuilder.html",tooltip="Makes a feature for every other point and builds only those in the way of task."];
  Node3 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="EveryOtherPointBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEveryOtherPointBuilder.html",tooltip="Makes a feature for every other point and builds all points."];
  Node2 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="EverythingBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEverythingBuilder.html",tooltip="Builds all points for each task."];
  Node5 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
}
