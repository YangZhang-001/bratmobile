digraph "EverythingBuilder"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="EverythingBuilder",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Builds all points for each task."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="WorldPointBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classWorldPointBuilder.html",tooltip="Each point is an object but each time the world is built, only the points in the way of the task are ..."];
  Node3 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="WorldBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classWorldBuilder.html",tooltip=" "];
  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="EveryOtherPointBuilder",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEveryOtherPointBuilder.html",tooltip="Makes a feature for every other point and builds all points."];
}
